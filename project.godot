; dot-server — a dedicated server framework for Godot.
;
; The distributable is `addons/dot_server/`. This project exists so the addon can
; be opened and validated standalone.
;
; `addons/dot_core/` is a LOCAL SYMLINK to ../dot-core/addons/dot_core and is
; gitignored — dot-core is a separate repository. See CLAUDE.md.

config_version=5

[application]

config/name="dot-server"
config/description="A dedicated server for Godot: console variables and commands, RCON, admin permissions, moderation, votes, and dynamic game loading."
config/version="0.1.0"
run/main_scene="res://examples/dedicated_server.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[editor_plugins]

enabled=PackedStringArray("res://addons/dot_core/plugin.cfg", "res://addons/dot_server/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
